# Copy this file to backend/.env. That file is gitignored.
# Run npm commands from the backend directory so dotenv finds backend/.env.
# A host can set the same names in its dashboard instead of a file.
#
# Development may omit DB_HOST, DB_USER, DB_NAME, and DB_PASSWORD.
# The API then uses localhost, root, unidex_db, and an empty password.
# NODE_ENV=production exits unless DB_HOST, DB_USER, and DB_NAME are non-empty
# and DB_PASSWORD is set (an empty password is allowed when the variable is present).

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=unidex_db

# Required in every environment. Production also requires at least 32 characters.
# Replace this placeholder before any shared deployment. Do not commit the real value.
JWT_SECRET=change_this_to_a_long_random_text

# Comma-separated browser origins, for example https://unidex.example.com
# This is the frontend origin, not the API URL. Leave it empty for local development
# so a phone on the LAN can call the API. Production exits when it is empty.
CORS_ORIGINS=

# Listen port. Defaults to 5000 when unset, including in production.
PORT=5000

# development or production. A public host must set production.
NODE_ENV=development
