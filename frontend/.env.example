# Copy to frontend/.env when you want a fixed API during `npm run dev`.
# Include the /api suffix. Vite inlines this value when you run `npm run build`.
# A production build that has no VITE_API_URL throws when the app loads.
# `npm run dev` does not need this file: it calls http://<page-hostname>:5000/api.
VITE_API_URL=http://localhost:5000/api
